# Copy to .env and fill in. NEVER commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres (POSTGRES_HOST=db is the in-Docker service name)
POSTGRES_DB=calsnap
POSTGRES_USER=calsnap
POSTGRES_PASSWORD=calsnap
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host-side Docker ports (remapped to avoid clashes with other local containers).
# Container-internal ports stay standard; only the host side changes.
DB_HOST_PORT=5544
REDIS_HOST_PORT=6399
WEB_HOST_PORT=8008

# Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
